# Copy to .env for local runs. Never commit .env.
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=global
# A GA Gemini Flash model ID from Vertex AI > Model Garden (not a preview model)
MODEL_ID=gemini-3.6-flash
# false = keep verdicts and Coercion Shield state in memory (no Firestore needed)
USE_FIRESTORE=false
